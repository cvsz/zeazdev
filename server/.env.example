# =============================================================================
# ZeaZDev Backend Verifier Service - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# =============================================================================

# Server Configuration
PORT=3000

# World ID Configuration
# Get these from https://developer.worldcoin.org/
WORLD_APP_ID=app_staging_your_app_id_here
WORLD_APP_API_KEY=api_your_secret_api_key_here
WORLD_ACTION_ID=verify-humanity

# Blockchain Configuration
# Get RPC URL from Alchemy, Infura, or other providers
RPC_URL=https://worldchain-mainnet.g.alchemy.com/v2/your-key

# Relayer Configuration
# Private key for the wallet that will pay gas fees
# IMPORTANT: Never commit real private keys to version control!
RELAYER_PRIVATE_KEY=0xYOUR_RELAYER_PRIVATE_KEY_HERE

# Contract Addresses (update after deployment)
WORLD_ID_REWARDS_CONTRACT=0x0000000000000000000000000000000000000000
ZEA_TOKEN_CONTRACT=0x0000000000000000000000000000000000000000

# Optional: Enable debug logging
DEBUG=false
